# Environment / secrets
.env
.env.*
!.env.example

# Databases
*.db
*.db-*
*.sqlite*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/
# frontend/dist is committed on purpose: a hosting service created before the
# Blueprint existed keeps its own build command, and if that command does not run
# `npm run build`, the API starts but app/main.py finds no SPA to mount. Shipping
# the build output makes the dashboard work on any host. Rebuild it with
# `npm run build --prefix frontend` whenever frontend source changes.
!frontend/dist/
# Anchored so it only ignores a root-level dist, not frontend/dist above.
/dist/


# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime logs
server.log
*.log

# Backups / junk
*.bak
*.bak2
*.darkbak
.freebuff/

.vercel
