generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Core Models ---

model User {
  id              Int          @id @default(autoincrement())
  email           String       @unique
  password        String
  name            String?
  image           String?
  emailVerified   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id])
  organizationId  Int?
  role            String       @default("MEMBER")
  invitations     Invitation[]
  apiKeys         ApiKey[]
  events          Event[]
  auditLogs       AuditLog[]
  organizationRoles OrganizationRole[]
  campaigns       Campaign[]   @relation("CampaignCreatedBy")
}

model Organization {
  id              Int          @id @default(autoincrement())
  name            String
  slug            String       @unique
  description     String?
  plan            String       @default("free")
  status          String       @default("active")
  settings        Settings?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  members         OrganizationRole[]
  invitations     Invitation[]
  users           User[]
  apiKeys         ApiKey[]
  contacts        Contact[]
  templates       Template[]
  campaigns       Campaign[]
  segments        Segment[]
  verifications   EmailVerification[]
  drafts          Draft[]
  events          Event[]
  inboxConfig     InboxConfig?
  replies         Reply[]
  followUps       FollowUp[]
  queueJobs       QueueJob[]
  auditLogs       AuditLog[]
  tags            Tag[]
  listFolders     ListFolder[]
  lists           List[]
}

model OrganizationRole {
  id              Int          @id @default(autoincrement())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  role            String
  joinedAt        DateTime     @default(now())

  @@unique([organizationId, userId])
}

model Invitation {
  id              Int          @id @default(autoincrement())
  email           String
  role            String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  invitedBy       User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById     Int?
  status          String       @default("pending")
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?

  @@unique([organizationId, email])
}

model ApiKey {
  id              Int          @id @default(autoincrement())
  key             String       @unique
  name            String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  permissions     Json         @default("[]")
  lastUsed        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById     Int?
}

// --- Contact Models ---

model Contact {
  id              Int          @id @default(autoincrement())
  email           String
  name            String?
  company         String?
  role            String?
  industry        String?
  phone           String?
  linkedin        String?
  notes           String?
  eligibleToEmail Boolean      @default(false)
  tags            Json         @default("[]")
  customFields    Json         @default("{}")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          Event[]
  verifications   EmailVerification[]
  drafts          Draft[]
  segmentContacts SegmentContact[]
  replies         Reply[]
  followUps       FollowUp[]
  tagContacts     Tag[]        @relation("ContactTag")
  templateUsageLogs TemplateUsageLog[]
  listContacts    ListContact[]

  @@unique([organizationId, email])
}

model Tag {
  id              Int          @id @default(autoincrement())
  name            String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  contacts        Contact[]    @relation("ContactTag")
  createdAt       DateTime     @default(now())

  @@unique([organizationId, name])
}

// --- Custom Lists ---

model ListFolder {
  id              Int          @id @default(autoincrement())
  name            String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  parentFolderId  Int?
  parentFolder    ListFolder?  @relation("FolderParent", fields: [parentFolderId], references: [id])
  subfolders      ListFolder[] @relation("FolderParent")
  lists           List[]
  color           String?      @default("#3b82f6")
  icon            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name])
}

model List {
  id              Int          @id @default(autoincrement())
  name            String
  description     String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  folderId        Int?
  folder          ListFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  contacts        ListContact[]
  isPublic        Boolean      @default(false)
  color           String?      @default("#3b82f6")
  contactCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name])
}

model ListContact {
  id          Int     @id @default(autoincrement())
  list        List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId      Int
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   Int
  addedAt     DateTime @default(now())

  @@unique([listId, contactId])
}

// --- Template Models ---

model Template {
  id              Int          @id @default(autoincrement())
  name            String
  category        String       @default("intro")
  subjectTemplate String
  bodyTemplate    String
  footerTemplate  String       @default("")
  variables       Json         @default("{}")
  tags            Json         @default("[]")
  isActive        Boolean      @default(true)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  usageLogs       TemplateUsageLog[]
  campaigns       Campaign[]
}

model TemplateUsageLog {
  id              Int          @id @default(autoincrement())
  template        Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId      Int
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       Int?
  usedAt          DateTime     @default(now())
  wasApproved     Boolean
  wasSent         Boolean
}

// --- Campaign Models ---

model Campaign {
  id              Int          @id @default(autoincrement())
  name            String
  description     String?
  type            String       @default("regular")
  status          String       @default("draft")
  template        Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId      Int?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  targetSegment   Segment?     @relation(fields: [targetSegmentId], references: [id], onDelete: SetNull)
  targetSegmentId Int?
  abTestConfig    Json?
  scheduledAt     DateTime?
  sentAt          DateTime?
  delivered       Int          @default(0)
  opened          Int          @default(0)
  clicked         Int          @default(0)
  replied         Int          @default(0)
  bounced         Int          @default(0)
  unsubscribed    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     Int?
  followUps       FollowUp[]
}

// --- Segment Models ---

model Segment {
  id              Int          @id @default(autoincrement())
  name            String
  description     String?
  query           Json
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  contacts        SegmentContact[]
  campaigns       Campaign[]
}

model SegmentContact {
  id          Int     @id @default(autoincrement())
  segment     Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  segmentId   Int
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   Int
  addedAt     DateTime @default(now())

  @@unique([segmentId, contactId])
}

// --- Email Verification Models ---

model EmailVerification {
  id              Int          @id @default(autoincrement())
  email           String
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       Int?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  status          String
  smtpCheck       String       @default("not_checked")
  mxCheck         String       @default("not_checked")
  catchAll        Boolean      @default(false)
  disposable      Boolean      @default(false)
  domain          String?
  lastChecked     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([email])
}

// --- Draft Models ---

model Draft {
  id              Int          @id @default(autoincrement())
  subject         String
  body            String
  status          String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       Int?
  variables       Json         @default("{}")
  priority        String       @default("normal")
  createdAt       DateTime     @default(now())
  sentAt          DateTime?
  errorMessage    String?
  attempts        Int          @default(0)
  lastAttemptAt   DateTime?
}

// --- Event Models ---

model Event {
  id              Int          @id @default(autoincrement())
  type            String
  payload         Json
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       Int?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?
  createdAt       DateTime     @default(now())
}

// --- Settings Models ---

model Settings {
  id              Int          @id @default(autoincrement())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int @unique
  goal            String       @default("book intro calls with sales leaders")
  businessName    String       @default("")
  businessOffer   String       @default("")
  dailyCap        Int          @default(50)
  domainCap       Int          @default(3)
  AUTO_APPROVE    Boolean      @default(false)
  AUTOPILOT       Boolean      @default(false)
  footerText      String       @default("")
  senderName      String       @default("")
  senderRole      String       @default("")
  companyWebsite  String       @default("")
  calendlyUrl     String       @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// --- Inbox/IMAP Models ---

model InboxConfig {
  id              Int          @id @default(autoincrement())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int @unique
  imapHost        String
  imapPort        Int          @default(993)
  imapUser        String
  imapPassword    String
  imapTls         Boolean      @default(true)
  lastSync        DateTime?
  status          String       @default("disconnected")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// --- Reply Models ---

model Reply {
  id              Int          @id @default(autoincrement())
  email           String
  subject         String
  bodyPreview     String
  sentiment       String
  classification  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       Int?
  createdAt       DateTime     @default(now())
  autoReplyStatus String       @default("pending")
  autoReplyMessage String?
}

// --- Follow-up Models ---

model FollowUp {
  id              Int          @id @default(autoincrement())
  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId      Int
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       Int?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  stage           Int
  subject         String
  body            String
  status          String
  scheduledAt     DateTime
  sentAt          DateTime?
  repliedAt       DateTime?
  createdAt       DateTime     @default(now())
}

// --- Queue/Job Models ---

model QueueJob {
  id              Int          @id @default(autoincrement())
  type            String
  payload         Json
  status          String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  errorMessage    String?
}

// --- Audit Log Models ---

model AuditLog {
  id              Int          @id @default(autoincrement())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  action          String
  entityType      String
  entityId        Int
  performedBy     User?        @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedById   Int?
  metadata        Json
  createdAt       DateTime     @default(now())
}