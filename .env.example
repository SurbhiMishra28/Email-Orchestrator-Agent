# Email Orchestrator Configuration
# Copy this file to .env and update the values

# ==============================================================================
# SINGLE-USER WORKSPACE
# ==============================================================================
# This app runs as one workspace with no login screen: every request is served
# as the implicit tenant/user below. There is no setting to turn a login back on.

# Identity of the implicit workspace.
LOCAL_USER_EMAIL=local@localhost
LOCAL_TENANT_NAME=Local

# JWT Secret Key - only used by the programmatic API (bearer tokens/API keys)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-very-long-secret-key-here-change-in-production

# Token expiry time in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Database Configuration
# ==============================================================================
#
# Local development: MySQL/MariaDB.
#   DATABASE_URL=mysql+pymysql://username:password@localhost:3306/email_orchestrator
#
# Production (Vercel + Neon): Postgres. ``postgres://`` and ``postgresql://``
# are rewritten to ``postgresql+psycopg://`` automatically, and ``sslmode=require``
# is added when missing. Use the POOLED connection string from the Neon console
# (the host contains ``-pooler``).
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname
DATABASE_URL=mysql+pymysql://root@localhost:3307/email_orchestrator

# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your-email@gmail.com
# Optional display name shown to recipients
SENDER_NAME=The Sales Team

# Resend email API (https://resend.com) - HTTPS on 443, not blocked by hosts
# that block SMTP ports (Render free tier blocks 25/465/587). Leave the key
# blank unless you intend to send through Resend. RESEND_FROM must be an
# identity verified in the Resend dashboard: Resend answers 403 for a
# consumer domain such as gmail.com, so a Gmail mailbox must send over SMTP.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Your Name <you@your-verified-domain.com>

# Which transport actually sends: smtp | resend | gmail_api | auto
# auto = Resend whenever RESEND_API_KEY is set (historical behaviour).
# Set this explicitly so delivery does not depend on whether a key is present.
MAIL_TRANSPORT=smtp

# Gmail API (send and read inbox over HTTPS; no custom domain or SMTP ports).
# Enable Gmail API in a Google Cloud project, create OAuth credentials, and use
# scripts/get_gmail_refresh_token.py to authorize the Gmail account.
# Use OAuth scopes gmail.send and gmail.readonly. Keep the refresh token secret.
# MAIL_TRANSPORT=gmail_api
# GMAIL_OAUTH_CLIENT_ID=your-oauth-client-id
# GMAIL_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# GMAIL_REFRESH_TOKEN=your-oauth-refresh-token
# GMAIL_USER_EMAIL=your-email@gmail.com

# IMAP (inbox sync - reads with BODY.PEEK, nothing is marked as read)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
# Minutes between automatic inbox polls
IMAP_POLL_MINUTES=10

# Follow-up drafting (never sends on its own)
FOLLOWUPS_ENABLED=true

# Refuse recipients that cannot be real mailboxes: reserved domains
# (example.com, *.test, localhost), disposable inboxes and mail-system
# addresses (mailer-daemon@, postmaster@, no-reply@). Leave on: the pipeline
# sends unattended, and a placeholder address only produces a bounce.
BLOCK_PLACEHOLDER_RECIPIENTS=true

# Dry-run mode. true records every send without opening an SMTP connection.
# The test suite sets this so it can never mail the account configured above.
MAIL_SUPPRESS_SEND=false

# Absolute base URL used in links inside emails (default: derived from the host).
# Leave blank in production: the platform's own URL is detected automatically
# (VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, RENDER_EXTERNAL_URL,
# RAILWAY_PUBLIC_DOMAIN, FLY_APP_NAME). A value here always wins, so set it only
# to override the detected host.
PUBLIC_BASE_URL=http://localhost:8000

# NVIDIA API Key (optional - for AI-powered email personalization)
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Application Settings
# Comma-separated allowed browser origins
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# ==============================================================================
# Access control (set BOTH on any public deployment)
# ==============================================================================
# The app has no login screen, so a public URL is an open door to the address
# book and the sending path. When both values are set, every request must
# present HTTP Basic credentials; the browser prompts once per session.
# /health, /api/track/* (recipient-facing open pixel and click redirect) and
# /api/cron/* (which uses CRON_SECRET) are exempt.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=replace-with-a-random-password

# ==============================================================================
# Serverless deployment (Vercel)
# ==============================================================================
# Vercel functions are frozen as soon as they respond, so no scheduler can run
# and no background worker survives. Set these in production:
#   ENABLE_BACKGROUND_JOBS=false
#   AUTO_INIT_DB=false          (run `python scripts/init_db.py` once instead)
#   ENABLE_LIVE_LOGS=false      (no WebSocket support)
# and drive automation from an external scheduler (cron-job.org) that calls
# POST /api/cron/tick with the CRON_SECRET header every minute.

# Scheduler / automation
# Both must be true for the scheduler to send queued drafts without a click.
AUTOPILOT=false
AUTO_APPROVE=false

# ==============================================================================
# Sending limits (per workspace, per UTC day)
# ==============================================================================
# Hard ceiling on sends per day. The default of 10 is deliberately conservative
# for a cold consumer mailbox. Raise it only when the mailbox/domain can carry
# the volume: a new domain that suddenly sends 50/day is what triggers provider
# filtering.
# DAILY_CAP=50

# Minimum seconds between two sends. 60 keeps a human-looking cadence; lower it
# only for a controlled one-off batch, since 50 sends at 60s takes ~50 minutes.
# PACING_SECONDS=60

# Per-recipient-domain cap defaults to 3 (Settings.domain_cap). A 50/day batch
# to one provider (e.g. 50 gmail.com recipients) needs Settings.domain_cap
# raised to 50 as well, or the domain cap blocks well before the daily cap.

# External cron driver. Set ENABLE_BACKGROUND_JOBS=false on hosts that freeze
# the process between requests (serverless), then point any scheduler at
# POST /api/cron/tick with this secret. Blank disables the route.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=replace-with-a-random-secret
# CRON_MAX_SECONDS=50
